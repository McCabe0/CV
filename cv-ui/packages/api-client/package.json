{
  "name": "@cv/api-client",
  "private": true,
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "api:spec": "node scripts/fetch-spec.mjs && pnpm api:types",
    "api:types": "openapi-typescript openapi.json --output src/schema.d.ts && prettier --write src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "mutation": "stryker run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "next": "16.4.5",
    "openapi-typescript": "7.13.0"
  }
}
