{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "paths": {
    "/profile": {
      "get": {
        "tags": ["profile"],
        "summary": "Your profile",
        "description": "404 until you have saved one.",
        "operationId": "find",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["profile"],
        "summary": "Save your profile",
        "description": "Creates it, or replaces the one you have.",
        "operationId": "save",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cv-requests/{id}/answers": {
      "put": {
        "tags": ["cv"],
        "summary": "Answer the interviewer",
        "description": "Any question left out is skipped. The writing then begins.",
        "operationId": "answer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswersRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}/fit": {
      "get": {
        "tags": ["jobs"],
        "summary": "Why a job fits you",
        "description": "404 until you have asked.",
        "operationId": "find_1",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitSummaryResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["jobs"],
        "summary": "Ask why a job fits you",
        "description": "202 while it is written: read it with GET until it is READY or FAILED. 200 when it was already written. Asking again after it FAILED writes it afresh.",
        "operationId": "request",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FitSummaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cv-requests": {
      "post": {
        "tags": ["cv"],
        "summary": "Ask for a CV",
        "description": "A general CV, aimed at your target role, or, with a jobId, one aimed at that listed job. 409 until you have saved a profile; 404 for a job no longer listed. Follow it at its Location.",
        "operationId": "request_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CvRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/companies": {
      "get": {
        "tags": ["admin"],
        "summary": "Every company, with its live jobs and last crawl",
        "description": "Tracked companies first.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompanyResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["admin"],
        "summary": "Track a company's job board",
        "description": "The board is read once first: 422 when it does not exist, 502 when it could not be read just now. Its first crawl is queued at once. A board tracked before is tracked again.",
        "operationId": "track",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackCompanyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin/companies/{id}/crawl": {
      "post": {
        "tags": ["admin"],
        "summary": "Crawl a company now",
        "description": "409 when it is no longer tracked.",
        "operationId": "crawl",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/jobs/matches": {
      "get": {
        "tags": ["jobs"],
        "summary": "Jobs that fit your skills",
        "description": "Best first, at most 50. 404 until you have saved a profile.",
        "operationId": "matches",
        "parameters": [
          {
            "name": "remoteOnly",
            "in": "query",
            "description": "Only jobs whose board says they are remote.",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "location",
            "in": "query",
            "description": "Only jobs whose location names this, eg London or UK.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobMatchResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cv-requests/{id}": {
      "get": {
        "tags": ["cv"],
        "summary": "A CV request as it stands",
        "description": "For a client that cannot stream, or reconnects.",
        "operationId": "find_2",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CvRequestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cv-requests/{id}/events": {
      "get": {
        "tags": ["cv"],
        "summary": "Follow a CV request",
        "description": "Server sent events, each named progress, each the whole request. Ends once it is completed or failed.",
        "operationId": "events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SseEmitter"
                }
              }
            }
          }
        }
      }
    },
    "/admin/companies/{id}": {
      "delete": {
        "tags": ["admin"],
        "summary": "Stop tracking a company",
        "description": "It is kept, but no longer crawled, and its live jobs close.",
        "operationId": "stop",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProfileRequest": {
        "type": "object",
        "description": "What the candidate tells us about themselves. The CV is written only from this.",
        "properties": {
          "name": {
            "type": "string",
            "example": "Casey Candidate",
            "maxLength": 100,
            "minLength": 0
          },
          "skills": {
            "type": "array",
            "description": "Each once; case and spaces are ignored.",
            "example": ["Kotlin", "SQL"],
            "items": {
              "type": "string",
              "maxLength": 50,
              "minLength": 0
            },
            "maxItems": 50,
            "minItems": 0
          },
          "experience": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 0
          },
          "education": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "targetRole": {
            "type": ["string", "null"],
            "maxLength": 100,
            "minLength": 0
          },
          "yearsOfExperience": {
            "type": ["string", "null"],
            "maxLength": 20,
            "minLength": 0
          },
          "location": {
            "type": ["string", "null"],
            "maxLength": 100,
            "minLength": 0
          },
          "workAuthorization": {
            "type": ["string", "null"],
            "maxLength": 100,
            "minLength": 0
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 0
            },
            "maxItems": 20,
            "minItems": 0
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 0
            },
            "maxItems": 20,
            "minItems": 0
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 50,
              "minLength": 0
            },
            "maxItems": 20,
            "minItems": 0
          },
          "email": {
            "type": ["string", "null"],
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "phone": {
            "type": ["string", "null"],
            "maxLength": 30,
            "minLength": 0
          },
          "linkedin": {
            "type": ["string", "null"],
            "maxLength": 300,
            "minLength": 0,
            "pattern": "^https?://\\S+$"
          },
          "portfolio": {
            "type": ["string", "null"],
            "maxLength": 300,
            "minLength": 0,
            "pattern": "^https?://\\S+$"
          },
          "workHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkExperienceRequest"
            },
            "maxItems": 30,
            "minItems": 0
          }
        },
        "required": [
          "certifications",
          "education",
          "experience",
          "languages",
          "name",
          "projects",
          "skills",
          "workHistory"
        ]
      },
      "WorkExperienceRequest": {
        "type": "object",
        "description": "A role the candidate has held.",
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "startDate": {
            "type": ["string", "null"],
            "example": "2021-03",
            "maxLength": 20,
            "minLength": 0
          },
          "endDate": {
            "type": ["string", "null"],
            "description": "Empty while the role is current.",
            "maxLength": 20,
            "minLength": 0
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 0
            },
            "maxItems": 20,
            "minItems": 0
          }
        },
        "required": ["bullets", "company", "title"]
      },
      "ProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "experience": {
            "type": "string"
          },
          "education": {
            "type": "string"
          },
          "targetRole": {
            "type": ["string", "null"]
          },
          "yearsOfExperience": {
            "type": ["string", "null"]
          },
          "location": {
            "type": ["string", "null"]
          },
          "workAuthorization": {
            "type": ["string", "null"]
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "email": {
            "type": ["string", "null"]
          },
          "phone": {
            "type": ["string", "null"]
          },
          "linkedin": {
            "type": ["string", "null"]
          },
          "portfolio": {
            "type": ["string", "null"]
          },
          "workHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkExperience"
            }
          }
        },
        "required": [
          "certifications",
          "education",
          "experience",
          "id",
          "languages",
          "name",
          "projects",
          "skills",
          "workHistory"
        ]
      },
      "WorkExperience": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startDate": {
            "type": ["string", "null"]
          },
          "endDate": {
            "type": ["string", "null"]
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["bullets", "company", "title"]
      },
      "AnswerRequest": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "text": {
            "type": ["string", "null"],
            "description": "Leave out, or empty, to skip the question.",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": ["questionId"]
      },
      "AnswersRequest": {
        "type": "object",
        "description": "The candidate's answers. A question left out is skipped.",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerRequest"
            },
            "maxItems": 5,
            "minItems": 0
          }
        },
        "required": ["answers"]
      },
      "AnswerResponse": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": ["string", "null"],
            "description": "Empty when skipped."
          }
        },
        "required": ["questionId"]
      },
      "Cv": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CvRole"
            }
          },
          "education": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "certifications",
          "education",
          "languages",
          "projects",
          "roles",
          "skills",
          "summary"
        ]
      },
      "CvRequestResponse": {
        "type": "object",
        "description": "A CV request: the interviewer's questions, each round, and the finished CV once completed.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": ["REQUESTED", "AWAITING_ANSWERS", "WRITING", "COMPLETED", "FAILED"]
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionResponse"
            }
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerResponse"
            }
          },
          "rounds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoundResponse"
            }
          },
          "cv": {
            "description": "Only once completed.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cv"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure": {
            "type": ["string", "null"],
            "description": "Only once failed: why."
          },
          "jobId": {
            "type": ["integer", "null"],
            "format": "int64",
            "description": "The job this CV is aimed at; none for a general CV."
          }
        },
        "required": ["answers", "id", "questions", "rounds", "status"]
      },
      "CvRole": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "dates": {
            "type": ["string", "null"]
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["bullets", "company", "title"]
      },
      "Issue": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["INVENTED_FACT", "NO_IMPACT", "MISSING_KEYWORD", "GENERIC_SUMMARY", "OTHER"]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": ["detail", "kind"]
      },
      "QuestionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string"
          }
        },
        "required": ["id", "text"]
      },
      "RoundResponse": {
        "type": "object",
        "description": "One turn of the writer and the critic: the critic's review, and the draft's summary.",
        "properties": {
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "approved": {
            "type": "boolean"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": ["approved", "issues", "number", "score", "summary"]
      },
      "FitSummaryResponse": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "text": {
            "type": ["string", "null"]
          },
          "failure": {
            "type": ["string", "null"]
          }
        },
        "required": ["jobId", "status"]
      },
      "CvRequestBody": {
        "type": "object",
        "description": "What to aim the CV at. No body, or no jobId, for a general CV.",
        "properties": {
          "jobId": {
            "type": ["integer", "null"],
            "format": "int64",
            "description": "A listed job, from your matches."
          }
        }
      },
      "TrackCompanyRequest": {
        "type": "object",
        "description": "A company's job board to track.",
        "properties": {
          "name": {
            "type": "string",
            "example": "Stripe",
            "maxLength": 100,
            "minLength": 0
          },
          "source": {
            "type": "string",
            "enum": ["GREENHOUSE", "LEVER", "ASHBY", "WORKABLE"]
          },
          "boardToken": {
            "type": "string",
            "description": "The company's name on its board, as in its board's url.",
            "example": "stripe",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "^\\s*[A-Za-z0-9][A-Za-z0-9._-]*\\s*$"
          }
        },
        "required": ["boardToken", "name", "source"]
      },
      "CompanyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["GREENHOUSE", "LEVER", "ASHBY", "WORKABLE"]
          },
          "boardToken": {
            "type": "string"
          },
          "tracked": {
            "type": "boolean"
          },
          "untrackedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "liveJobs": {
            "type": "integer",
            "format": "int32"
          },
          "lastCrawl": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CrawlResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["boardToken", "id", "liveJobs", "name", "source", "tracked"]
      },
      "CrawlResponse": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "outcome": {
            "type": "string"
          },
          "found": {
            "type": "integer",
            "format": "int32"
          },
          "added": {
            "type": "integer",
            "format": "int32"
          },
          "closed": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": ["string", "null"]
          }
        },
        "required": ["added", "at", "closed", "found", "outcome"]
      },
      "JobMatchResponse": {
        "type": "object",
        "properties": {
          "id": {
