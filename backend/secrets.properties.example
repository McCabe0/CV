# Template for local secrets. Copy to `secrets.properties` and fill in real values.
#   cp secrets.properties.example secrets.properties
# secrets.properties is gitignored; this template is safe to commit.

# Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Neon Postgres (used when running with SPRING_PROFILES_ACTIVE=prod)
DATABASE_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
DATABASE_USER=your-db-user
DATABASE_PASSWORD=your-db-password

# JWT signing secret (Milestone 2 — auth). Generate one:
#   openssl rand -base64 48
JWT_SECRET=generate-a-long-random-secret
