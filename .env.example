# Copy to .env (git ignores it) and fill in. docker compose reads .env from this folder.

# The LLM behind the CV agents: gemini (the default) or claude. One model for all three agents.
# The cv-worker will not start without the chosen provider's key. See decisions/agents.md.
LLM_PROVIDER=gemini
# Blank: the provider's default (gemini-flash-latest, or claude-opus-5-5).
LLM_MODEL=

# Free from https://aistudio.google.com. The free tier may use what is sent to improve Google's
# products: use test profiles only, never real candidates' data.
GEMINI_API_KEY=

# Only for LLM_PROVIDER=claude. Paid per token, from https://platform.claude.com.
ANTHROPIC_API_KEY=
